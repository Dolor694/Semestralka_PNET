@using Gym.WebUI.Contexts
@implements IDisposable
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Gym Training Aplication</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="d-flex flex-column h-100">
        <div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            @if (UserContext == null || !UserContext.IsLoggedIn)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="register">
                        <span class="bi bi-person-add-fill-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-check-fill-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            }
            else
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="plans">
                        <span class="bi bi-card-list-fill-nav-menu" aria-hidden="true"></span> Plans
                    </NavLink>
                </div>
            }
        </div>

        <div class="mt-auto">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profile">
                    <span class="bi bi-person-circle-fill-nav-menu" aria-hidden="true"></span> Profile Manager
                </NavLink>
            </div>

            @if (UserContext is not null && UserContext.IsLoggedIn)
            {
                <div class="nav-item px-3">
                    <a class="nav-link" href="" @onclick="LogoutAsync" @onclick:preventDefault="true">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
                    </a>
                </div>
            }
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Context of the user
    [CascadingParameter]
    private UserContext? UserContext { get; set; }

    // Subscribe to user context changes on parameter changes
    protected override void OnParametersSet()
    {
        if (UserContext != null)
        {
            UserContext.OnChange -= HandleUserContextChanged;
            UserContext.OnChange += HandleUserContextChanged;
        }
    }

    // Handle user context changes to update the UI immediately on login or logout
    private void HandleUserContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void LogoutAsync()
    {
        UserContext?.Clear();
        Navigation.NavigateTo("/", true);
    }

    // Unsubscribe from the event on disposal
    public void Dispose()
    {
        if (UserContext != null)
        {
            UserContext.OnChange -= HandleUserContextChanged;
        }
    }
}
