@page "/trainings/{PlanId:int}"

<PageTitle>Trainings</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Trainings in Plan #@PlanId</h3>
        <button type="button" class="btn btn-outline-secondary" @onclick="GoBackToPlans">Back to Plans</button>
    </div>

    @if (isLoading)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading trainings...</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var training in trainings)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">Training #@training.Id</h5>
                            <p class="mb-2"><strong>Date:</strong> @training.Date.ToString("yyyy-MM-dd")</p>
                            <p class="mb-3"><strong>Sequence:</strong> @training.IdTrainingTypeSequence</p>

                            <div class="mt-auto d-grid gap-2">
                                <button type="button" class="btn btn-outline-secondary" disabled>Update</button>
                                <button type="button" class="btn btn-outline-danger" disabled>Delete</button>
                                <button type="button" class="btn btn-primary" disabled>Open</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 border-primary shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                        <h5 class="card-title">Generate New Training</h5>
                        <p class="text-muted mb-3">Generate a new training.</p>
                        <button type="button" class="btn btn-primary" disabled>
                            + Generate Training
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int PlanId { get; set; }

    [Inject]
    private HttpClient Http { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private readonly List<TrainingDto> trainings = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTrainingsAsync();
    }

    private async Task LoadTrainingsAsync()
    {
        isLoading = true;
        errorMessage = null;
        trainings.Clear();

        try
        {
            var response = await Http.GetAsync($"api/training/plan/{PlanId}");

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                isLoading = false;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Failed to load trainings ({(int)response.StatusCode}).";
                isLoading = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<List<TrainingDto>>();
            if (result is not null)
            {
                trainings.AddRange(result);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load trainings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBackToPlans()
    {
        Navigation.NavigateTo("/plans");
    }

    private sealed record TrainingDto(int Id, DateOnly Date, int IdTrainingPlan, int IdTrainingTypeSequence);
}